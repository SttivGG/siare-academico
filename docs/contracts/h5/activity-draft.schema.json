        "extractionVersion": {
          "type": "string",
          "pattern": "^operation:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "type": {
          "enum": [
            "QUIZ",
            "CROSSWORD"
          ]
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "\\S"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "gridSize": {
          "type": "integer",
          "minimum": 5,
          "maximum": 25
        },
        "fragmentIndexes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1999
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "CROSSWORD"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 2,
                "maximum": 12
              }
            }
          }
        }
      ]
    },
    "ReviseDraftRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "draftRevision",
        "draft"
      ],
      "properties": {
        "draftRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483646
        },
        "draft": {
          "$ref": "#/$defs/ActivityBankDraft"
        }
      }
    },
    "PublishDraftRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "draftRevision",
        "reviewConfirmed",
        "idempotencyKey"
      ],
      "properties": {
        "draftRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483646
        },
        "reviewConfirmed": {
          "const": true
        },
        "idempotencyKey": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      }
    },
    "PublicDraftView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "draftId",
        "subjectId",
        "documentId",
        "extractionVersion",
        "type",
        "topic",
        "count",
        "gridSize",
        "draftRevision",
        "expiresAt",
        "status",
        "draft",
        "quality",
        "qualityAppliesToRevision",
        "warnings",
        "generatorVersion"
      ],
      "properties": {
        "draftId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "subjectId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "documentId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "extractionVersion": {
          "type": "string",
