# LOCAL DEVELOPMENT ONLY. Run scripts/Initialize-Siare.ps1 to create .env.
# Blank secrets are intentional: Compose must refuse to start without them.
COMPOSE_PROJECT_NAME=siare-academico
SIARE_INSTANCE_ID=
MYSQL_DATABASE=siare
MYSQL_USER=siare_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MONGO_DATABASE=siare_content
MONGO_USER=siare_app
MONGO_PASSWORD=
MONGO_ROOT_USER=siare_admin
MONGO_ROOT_PASSWORD=
REDIS_PASSWORD=

# RSA keys live in the persistent jwt-keys Docker volume, outside the repository.
JWT_ISSUER=siare-core
JWT_TTL=PT30M
APP_ORIGIN=http://127.0.0.1:3100
# Local HTTP only. Set true when serving the frontend over HTTPS in production.
SESSION_COOKIE_SECURE=false

# Phase 2: new independent service credential; never sent to the browser.
CONTENT_SERVICE_TOKEN=
DOCUMENT_MAX_BYTES=15728640
# Multipart envelope includes at most 128 KiB beyond the file limit.
DOCUMENT_REQUEST_MAX_BYTES=15859712

# H1: infrastructure and SQL connectivity only; academic ingestion is pending.
CLICKHOUSE_DB=siare_analytics
CLICKHOUSE_USER=siare_analytics
CLICKHOUSE_PASSWORD=
