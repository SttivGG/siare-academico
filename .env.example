# LOCAL DEVELOPMENT ONLY. Run scripts/Initialize-Siare.ps1 to create .env.
# Blank secrets are intentional: Compose must refuse to start without them.
COMPOSE_PROJECT_NAME=siare-academico
SIARE_INSTANCE_ID=
MYSQL_DATABASE=siare
MYSQL_USER=siare_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MONGO_DATABASE=siare_content
MONGO_USER=siare_app
MONGO_PASSWORD=
MONGO_ROOT_USER=siare_admin
MONGO_ROOT_PASSWORD=
REDIS_PASSWORD=

# RSA keys live in the persistent jwt-keys Docker volume, outside the repository.
JWT_ISSUER=siare-core
H2A_ACCESS_TTL=PT5M
H2A_SESSION_IDLE=PT30M
H2A_SESSION_ABSOLUTE=P7D
H2A_SESSION_MAXIMUM=5
H2A_ARGON2_MEMORY_KIB=19456
H2A_ARGON2_ITERATIONS=2
H2A_ARGON2_PARALLELISM=1
APP_ORIGIN=http://127.0.0.1:3100
# Local HTTP only. Set true when serving the frontend over HTTPS in production.
SESSION_COOKIE_SECURE=false

# Phase 2: new independent service credential; never sent to the browser.
CONTENT_SERVICE_TOKEN=
DOCUMENT_MAX_BYTES=15728640
# Multipart envelope includes at most 128 KiB beyond the file limit.
DOCUMENT_REQUEST_MAX_BYTES=15859712

# Adaptive learning: independent secret shared only by Spring and Flask.
# Rotated and approved separately from document extraction credentials.
LEARNING_SERVICE_TOKEN=
LEARNING_MAX_BYTES=65536
LEARNING_MODEL_PATH=

# H1: infrastructure and SQL connectivity only; academic ingestion is pending.
CLICKHOUSE_DB=siare_analytics
CLICKHOUSE_USER=siare_analytics
CLICKHOUSE_PASSWORD=
# H2-B1: key file MUST be outside the repository. Provision once with Initialize-H2B1.ps1.
# Set an absolute path on Linux; Windows defaults to LOCALAPPDATA/SIARE/identity/totp.key.
# H2B1_MFA_KEY_FILE=/secure/siare/totp.key
H2B1_SMTP_HOST=
H2B1_SMTP_PORT=587
H2B1_SMTP_USERNAME=
H2B1_SMTP_PASSWORD=
H2B1_SMTP_FROM=

# H2-B2: independent opt-in. Empty credentials always disable the provider.
GOOGLE_OIDC_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ISSUER=https://accounts.google.com
GOOGLE_REDIRECT_URI=http://127.0.0.1:3100/api/oidc/callback/google
GITLAB_OIDC_ENABLED=false
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_ISSUER=https://gitlab.com
GITLAB_REDIRECT_URI=http://127.0.0.1:3100/api/oidc/callback/gitlab

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=75
GEMINI_MAX_RETRIES=2
GEMINI_MAX_INPUT_CHARS=100000
GEMINI_MAX_QUESTIONS=20
GEMINI_MAX_REQUESTS_PER_MINUTE=30
GEMINI_MAX_REQUEST_BYTES=131072
